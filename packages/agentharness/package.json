{
  "name": "agentharness",
  "version": "0.0.0",
  "description": "A folder is an agent: agent.json, prompt.md and knowledge/ deployed to Amazon Bedrock AgentCore with AWS CDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sattaman/agentharness.git",
    "directory": "packages/agentharness"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agentharness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node assets.mjs && vitest run",
    "assets": "node assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "3.1169.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1168.0",
    "@aws-sdk/client-cloudformation": "3.1169.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-s3": "3.1168.0",
    "cdk-nag": "3.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2"
  }
}
