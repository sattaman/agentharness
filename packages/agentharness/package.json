{
  "name": "agentharness",
  "version": "0.0.0",
  "description": "A folder is an agent: agent.json, prompt.md and knowledge/ deployed to Amazon Bedrock AgentCore with AWS CDK.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agentharness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1168.0",
    "@aws-sdk/client-cloudformation": "3.1168.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1168.0",
    "cdk-nag": "3.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@smithy/types": "4.20.0",
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1"
  }
}
